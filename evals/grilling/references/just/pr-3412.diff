+fn serialize_dotenv<S>(value: &Value, serializer: S) -> Result<S::Ok, S::Error>
+where
+  S: Serializer,
+{
+  match value.elements() {
+    [] => serializer.serialize_none(),
+    [one] => one.serialize(serializer),
+    many => many.serialize(serializer),
+  }
+}
